rules_version = '2';

// Cloud Firestore Security Rules for EduLens.
//
// Role model (from UserModel and auth tokens):
// - districtAdmin: Full district-wide read/write access.
// - schoolAdmin: Read/write within assigned schoolId.
// - teacher: Read/write attendance, exams, timetables & examAttendance within assigned schoolId.
// - student: Read-only for own profile, attendance, fees, leaveRequests & school exams.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return hasUserProfile() ? getUserData().role : '';
    }

    function getUserSchoolId() {
      return hasUserProfile() && ('schoolId' in getUserData()) ? getUserData().schoolId : '';
    }

    function isDistrictAdmin() {
      return getUserRole() == 'districtAdmin';
    }

    function isSchoolAdmin(schoolId) {
      return getUserRole() == 'schoolAdmin' && getUserSchoolId() == schoolId;
    }

    function isTeacher(schoolId) {
      return getUserRole() == 'teacher' && getUserSchoolId() == schoolId;
    }

    function isStudent() {
      return getUserRole() == 'student';
    }

    // --- Document Rules ---

    // 1. Users Collection (/users/{uid})
    match /users/{uid} {
      allow read: if isSignedIn() && (
        isDistrictAdmin() ||
        request.auth.uid == uid ||
        (!isStudent() && getUserSchoolId() == resource.data.schoolId)
      );

      allow create: if isSignedIn() && (
        isDistrictAdmin() ||
        (
          request.auth.uid == uid &&
          request.resource.data.uid == uid &&
          (request.resource.data.role == 'student' || request.resource.data.role == 'teacher')
        )
      );

      allow update: if isSignedIn() && (
        isDistrictAdmin() ||
        (
          request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.uid == resource.data.uid
        )
      );

      allow delete: if isDistrictAdmin();
    }

    // 2. Schools Collection (/schools/{schoolId})
    match /schools/{schoolId} {
      function isValidSchoolData() {
        return request.resource.data.schoolId is string &&
          request.resource.data.schoolId == schoolId &&
          request.resource.data.schoolName is string &&
          request.resource.data.schoolName.size() > 0 &&
          request.resource.data.location is string &&
          request.resource.data.location.size() > 0;
      }

      allow read: if isSignedIn();

      allow create: if isDistrictAdmin() && isValidSchoolData();

      allow update: if isSignedIn() && isValidSchoolData() && (
        isDistrictAdmin() ||
        (
          isSchoolAdmin(schoolId) &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.schoolName == resource.data.schoolName &&
          request.resource.data.location == resource.data.location
        )
      );

      allow delete: if isDistrictAdmin();
    }

    // 3. Students Collection (/students/{studentId})
    match /students/{studentId} {
      allow read: if isSignedIn() && (
        isDistrictAdmin() ||
        (!isStudent() && getUserSchoolId() == resource.data.schoolId) ||
        (isStudent() && (resource.data.studentId == request.auth.uid || studentId == request.auth.uid))
      );

      allow create: if isSignedIn() && (
        isDistrictAdmin() ||
        isSchoolAdmin(request.resource.data.schoolId)
      );

      allow update: if isSignedIn() && (
        isDistrictAdmin() ||
        isSchoolAdmin(request.resource.data.schoolId)
      );

      allow delete: if isDistrictAdmin();
    }

    // 4. Attendance Collection (/attendance/{attendanceId})
    match /attendance/{attendanceId} {
      function isValidAttendanceData() {
        return request.resource.data.attendanceId is string &&
          request.resource.data.studentId is string &&
          request.resource.data.studentId.size() > 0 &&
          request.resource.data.schoolId is string &&
          request.resource.data.schoolId.size() > 0 &&
          request.resource.data.teacherId is string &&
          request.resource.data.teacherId.size() > 0 &&
          request.resource.data.date is string &&
          request.resource.data.date.size() > 0 &&
          request.resource.data.status is string &&
          request.resource.data.status.size() > 0;
      }

      allow read: if isSignedIn() && (
        isDistrictAdmin() ||
        getUserSchoolId() == resource.data.schoolId ||
        (isStudent() && resource.data.studentId == request.auth.uid)
      );

      allow create: if isSignedIn() && isValidAttendanceData() && (
        isDistrictAdmin() ||
        (
          isTeacher(request.resource.data.schoolId) &&
          request.resource.data.schoolId == getUserSchoolId() &&
          request.resource.data.teacherId == request.auth.uid
        )
      );

      allow update: if isSignedIn() && isValidAttendanceData() && (
        isDistrictAdmin() ||
        (
          isTeacher(resource.data.schoolId) &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.attendanceId == resource.data.attendanceId &&
          request.resource.data.studentId == resource.data.studentId &&
          request.resource.data.date == resource.data.date
        )
      );

      allow delete: if isDistrictAdmin();
    }

    // 5. Fees Collection (/fees/{feeId})
    match /fees/{feeId} {
      function isValidFeeData() {
        return request.resource.data.feeId is string &&
          request.resource.data.studentId is string &&
          request.resource.data.studentId.size() > 0 &&
          request.resource.data.schoolId is string &&
          request.resource.data.schoolId.size() > 0 &&
          request.resource.data.totalDue is number &&
          request.resource.data.paidAmount is number &&
          request.resource.data.status is string &&
          request.resource.data.status.size() > 0;
      }

      allow read: if isSignedIn() && (
        isDistrictAdmin() ||
        getUserSchoolId() == resource.data.schoolId ||
        (isStudent() && resource.data.studentId == request.auth.uid)
      );

      allow create: if isSignedIn() && isValidFeeData() && (
        isDistrictAdmin() ||
        isSchoolAdmin(request.resource.data.schoolId)
      );

      allow update: if isSignedIn() && isValidFeeData() && (
        isDistrictAdmin() ||
        (
          isSchoolAdmin(resource.data.schoolId) &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.feeId == resource.data.feeId &&
          request.resource.data.studentId == resource.data.studentId
        )
      );

      allow delete: if isDistrictAdmin();
    }

    // 5. Exams Collection (/exams/{examId})
    match /exams/{examId} {
      function isValidExamData() {
        return request.resource.data.examId is string &&
          request.resource.data.examId == examId &&
          request.resource.data.schoolId is string &&
          request.resource.data.schoolId.size() > 0 &&
          request.resource.data.subject is string &&
          request.resource.data.subject.size() > 0 &&
          request.resource.data.className is string &&
          request.resource.data.className.size() > 0 &&
          request.resource.data.date is string &&
          request.resource.data.date.size() > 0 &&
          request.resource.data.startTime is string &&
          request.resource.data.endTime is string &&
          request.resource.data.createdBy is string;
      }

      allow read: if isSignedIn() && (
        isDistrictAdmin() ||
        getUserSchoolId() == resource.data.schoolId
      );

      allow create: if isSignedIn() && isValidExamData() && (
        isDistrictAdmin() ||
        (
          (isSchoolAdmin(request.resource.data.schoolId) || isTeacher(request.resource.data.schoolId)) &&
          request.resource.data.schoolId == getUserSchoolId() &&
          request.resource.data.createdBy == request.auth.uid
        )
      );

      allow update: if isSignedIn() && isValidExamData() && (
        isDistrictAdmin() ||
        (
          (isSchoolAdmin(resource.data.schoolId) || isTeacher(resource.data.schoolId)) &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.examId == resource.data.examId &&
          request.resource.data.createdBy == resource.data.createdBy
        )
      );

      allow delete: if isSignedIn() && (
        isDistrictAdmin() ||
        isSchoolAdmin(resource.data.schoolId)
      );
    }

    // 6. Leave Requests Collection (/leaveRequests/{requestId})
    match /leaveRequests/{requestId} {
      function isValidLeaveRequestData() {
        return request.resource.data.requestId is string &&
          request.resource.data.requestId == requestId &&
          request.resource.data.studentId is string &&
          request.resource.data.studentId.size() > 0 &&
          request.resource.data.studentName is string &&
          request.resource.data.studentName.size() > 0 &&
          request.resource.data.schoolId is string &&
          request.resource.data.schoolId.size() > 0 &&
          request.resource.data.className is string &&
          request.resource.data.startDate is string &&
          request.resource.data.startDate.size() > 0 &&
          request.resource.data.endDate is string &&
          request.resource.data.endDate.size() > 0 &&
          request.resource.data.startDate <= request.resource.data.endDate &&
          request.resource.data.reason is string &&
          request.resource.data.reason.trim().size() > 0 &&
          request.resource.data.submittedAt is string;
      }

      allow read: if isSignedIn() && (
        isDistrictAdmin() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        ((isSchoolAdmin(resource.data.schoolId) || isTeacher(resource.data.schoolId)) &&
          getUserSchoolId() == resource.data.schoolId)
      );

      allow create: if isSignedIn() && isStudent() &&
        isValidLeaveRequestData() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.schoolId == getUserSchoolId() &&
        request.resource.data.status == 'Pending' &&
        !('reviewedBy' in request.resource.data) &&
        !('reviewedAt' in request.resource.data) &&
        !('reviewComment' in request.resource.data);

      allow update: if isSignedIn() &&
        (isSchoolAdmin(resource.data.schoolId) || isTeacher(resource.data.schoolId)) &&
        getUserSchoolId() == resource.data.schoolId &&
        resource.data.status == 'Pending' &&
        (request.resource.data.status == 'Approved' || request.resource.data.status == 'Rejected') &&
        request.resource.data.requestId == resource.data.requestId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.schoolId == resource.data.schoolId &&
        request.resource.data.studentName == resource.data.studentName &&
        request.resource.data.className == resource.data.className &&
        request.resource.data.startDate == resource.data.startDate &&
        request.resource.data.endDate == resource.data.endDate &&
        request.resource.data.reason == resource.data.reason &&
        request.resource.data.submittedAt == resource.data.submittedAt &&
        request.resource.data.reviewedBy == request.auth.uid;

      allow delete: if false;
    }

    // 7. Timetables Collection (/timetables/{timetableId})
    match /timetables/{timetableId} {
      function isValidTimetableData() {
        return request.resource.data.timetableId is string &&
          request.resource.data.timetableId == timetableId &&
          request.resource.data.schoolId is string &&
          request.resource.data.schoolId.size() > 0 &&
          request.resource.data.teacherId is string &&
          request.resource.data.teacherId.size() > 0 &&
          request.resource.data.className is string &&
          request.resource.data.subject is string &&
          request.resource.data.dayOfWeek is string &&
          request.resource.data.startTime is string &&
          request.resource.data.endTime is string &&
          request.resource.data.startTime <= request.resource.data.endTime;
      }

      allow read: if isSignedIn() && (
        isDistrictAdmin() ||
        getUserSchoolId() == resource.data.schoolId
      );

      allow create: if isSignedIn() && isValidTimetableData() && (
        isDistrictAdmin() ||
        (
          (isSchoolAdmin(request.resource.data.schoolId) || isTeacher(request.resource.data.schoolId)) &&
          request.resource.data.schoolId == getUserSchoolId()
        )
      );

      allow update: if isSignedIn() && isValidTimetableData() && (
        isDistrictAdmin() ||
        (
          (isSchoolAdmin(resource.data.schoolId) || isTeacher(resource.data.schoolId)) &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.timetableId == resource.data.timetableId &&
          request.resource.data.teacherId == resource.data.teacherId
        )
      );

      allow delete: if isSignedIn() && (
        isDistrictAdmin() ||
        isSchoolAdmin(resource.data.schoolId)
      );
    }

    // 8. Exam Attendance Collection (/examAttendance/{examAttendanceId})
    match /examAttendance/{examAttendanceId} {
      function isValidExamAttendanceData() {
        return request.resource.data.examAttendanceId is string &&
          request.resource.data.examAttendanceId == examAttendanceId &&
          request.resource.data.examId is string &&
          request.resource.data.examId.size() > 0 &&
          request.resource.data.studentId is string &&
          request.resource.data.studentId.size() > 0 &&
          request.resource.data.schoolId is string &&
          request.resource.data.schoolId.size() > 0 &&
          request.resource.data.recordedBy is string &&
          request.resource.data.recordedBy.size() > 0 &&
          request.resource.data.status is string &&
          (request.resource.data.status == 'Present' || request.resource.data.status == 'Absent');
      }

      allow read: if isSignedIn() && (
        isDistrictAdmin() ||
        getUserSchoolId() == resource.data.schoolId ||
        (isStudent() && resource.data.studentId == request.auth.uid)
      );

      allow create: if isSignedIn() && isValidExamAttendanceData() && (
        isDistrictAdmin() ||
        (
          (isSchoolAdmin(request.resource.data.schoolId) || isTeacher(request.resource.data.schoolId)) &&
          request.resource.data.schoolId == getUserSchoolId() &&
          request.resource.data.recordedBy == request.auth.uid
        )
      );

      allow update: if isSignedIn() && isValidExamAttendanceData() && (
        isDistrictAdmin() ||
        (
          (isSchoolAdmin(resource.data.schoolId) || isTeacher(resource.data.schoolId)) &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.examAttendanceId == resource.data.examAttendanceId &&
          request.resource.data.examId == resource.data.examId &&
          request.resource.data.studentId == resource.data.studentId &&
          request.resource.data.recordedBy == request.auth.uid
        )
      );

      allow delete: if isDistrictAdmin();
    }
  }
}
